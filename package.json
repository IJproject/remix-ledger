{
  "name": "remix-ledger",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names css,app --prefix-colors cyan,green \"npm:css:watch\" \"npm:dev:server\"",
    "dev:server": "NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx server.ts",
    "hmr": "concurrently --kill-others --names css,app --prefix-colors cyan,green \"npm:css:watch\" \"npm:hmr:server\"",
    "hmr:server": "NODE_ENV=development node --env-file-if-exists=.env hmr.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test node --env-file-if-exists=.env node_modules/.bin/remix test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:status": "node --env-file-if-exists=.env node_modules/.bin/remix db status",
    "db:migrate": "node --env-file-if-exists=.env node_modules/.bin/remix db migrate",
    "db:seed": "node --env-file-if-exists=.env node_modules/.bin/remix db seed",
    "css:build": "tailwindcss -i ./app/app.css -o ./public/app.css --minify",
    "css:watch": "tailwindcss -i ./app/app.css -o ./public/app.css --watch",
    "prestart": "npm run css:build",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "remix": "^3.0.0-rc.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.4",
    "typescript": "latest"
  }
}
