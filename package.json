{
  "name": "remix-ledger",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node --env-file-if-exists=.env hmr.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test node --env-file-if-exists=.env node_modules/.bin/remix test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:status": "node --env-file-if-exists=.env node_modules/.bin/remix db status",
    "db:migrate": "node --env-file-if-exists=.env node_modules/.bin/remix db migrate",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "remix": "^3.0.0-rc.5"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "typescript": "latest"
  }
}
